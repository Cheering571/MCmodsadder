<UserControl x:Class="McModsAdder.Views.ModDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" MinWidth="420" MaxHeight="700"
        Background="#FF1F232B" FontFamily="Microsoft YaHei UI">
    <Border Background="#FF1F232B" BorderBrush="#FF46D369" BorderThickness="1" CornerRadius="12" Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="80" Height="80" CornerRadius="12" Background="#FF2A303A">
                <Image Source="{Binding Icon}" Width="80" Height="80" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="18,4,0,0">
                <TextBlock Text="{Binding Result.Name}" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Result.Author, StringFormat='作者：{0}'}" Margin="0,8,0,0" Foreground="#FF9AA2AD" />
                <TextBlock Foreground="#FF46D369" Margin="0,6,0,0"><Run Text="下载量：" /><Run Text="{Binding Result.Downloads, Converter={StaticResource FriendlyNumber}}" /></TextBlock>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Mod 描述" FontWeight="SemiBold" Foreground="#FFC7CBD1" Margin="0,0,0,8" />
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Result.Summary}" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="#FFD7DBE0" />
            </ScrollViewer>
            <WrapPanel Margin="0,16,0,0">
                <Button Content="打开 Modrinth 来源页" Tag="{Binding Result.SourceUrl}" Click="LinkButton_Click" Padding="12,6" Margin="0,0,10,0" />
                <Button Content="打开 MCMod 百科" Tag="{Binding Result.McModUrl}" Click="LinkButton_Click" Padding="12,6" />
            </WrapPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="拖动面板可移动 · 单击面板外区域关闭 · 链接将在系统默认浏览器中打开" FontSize="11" Foreground="#FF8A9099" Margin="0,18,0,0" />
    </Grid>
    </Border>
</UserControl>
