<Page x:Class="MCModPlus.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="主页"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <Page.Resources>
        <SolidColorBrush x:Key="WorldBg" Color="#FF1F2328" />
        <SolidColorBrush x:Key="Stone" Color="#FF3B4148" />
        <SolidColorBrush x:Key="StoneDark" Color="#FF252A30" />
        <SolidColorBrush x:Key="Wood" Color="#FF6B472F" />
        <SolidColorBrush x:Key="WoodDark" Color="#FF3E2A20" />
        <SolidColorBrush x:Key="Dirt" Color="#FF60412F" />
        <SolidColorBrush x:Key="Grass" Color="#FF4D8A45" />
        <SolidColorBrush x:Key="PixelGreen" Color="#FF75C457" />
        <SolidColorBrush x:Key="PixelGold" Color="#FFF0C45C" />
        <SolidColorBrush x:Key="PixelBlue" Color="#FF63B7D4" />
        <SolidColorBrush x:Key="PixelPurple" Color="#FFB58ADE" />
        <SolidColorBrush x:Key="PixelText" Color="#FFF5F1E8" />
        <SolidColorBrush x:Key="PixelMuted" Color="#FFC6C6BE" />
        <DropShadowEffect x:Key="PixelShadow" BlurRadius="0" ShadowDepth="5" Direction="315" Color="#FF08090B" Opacity="0.9" />
        <DrawingBrush x:Key="WoodPlanks" TileMode="Tile" Viewport="0,0,96,48" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF5C3D29" Geometry="M0,0 H96 V48 H0 Z" />
                    <GeometryDrawing Brush="#FF775039" Geometry="M0,2 H96 V5 H0 Z M0,24 H96 V27 H0 Z" />
                    <GeometryDrawing Brush="#FF3E291F" Geometry="M0,20 H96 V23 H0 Z M0,43 H96 V46 H0 Z M31,0 H35 V22 H31 Z M70,25 H74 V48 H70 Z" />
                    <GeometryDrawing Brush="#FF946443" Geometry="M8,10 H22 V12 H8 Z M44,33 H62 V35 H44 Z M78,12 H91 V14 H78 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="GrassDirt" TileMode="Tile" Viewport="0,0,80,80" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF5B402E" Geometry="M0,0 H80 V80 H0 Z" />
                    <GeometryDrawing Brush="#FF4A823F" Geometry="M0,0 H80 V18 H0 Z" />
                    <GeometryDrawing Brush="#FF72AD4D" Geometry="M5,4 H17 V7 H5 Z M43,10 H58 V13 H43 Z" />
                    <GeometryDrawing Brush="#FF76503A" Geometry="M10,30 H16 V36 H10 Z M51,47 H59 V54 H51 Z M27,65 H34 V72 H27 Z" />
