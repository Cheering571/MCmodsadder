            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="StoneBricks" TileMode="Tile" Viewport="0,0,96,64" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF384047" Geometry="M0,0 H96 V64 H0 Z" />
                    <GeometryDrawing Brush="#FF555E62" Geometry="M4,4 H43 V27 H4 Z M51,4 H91 V27 H51 Z M4,36 H27 V59 H4 Z M35,36 H75 V59 H35 Z M83,36 H92 V59 H83 Z" />
                    <GeometryDrawing Brush="#FF252B31" Geometry="M0,28 H96 V35 H0 Z M44,0 H50 V28 H44 Z M28,35 H34 V64 H28 Z M76,35 H82 V64 H76 Z" />
                    <GeometryDrawing Brush="#FF707878" Geometry="M8,7 H29 V10 H8 Z M57,7 H80 V10 H57 Z M39,39 H63 V42 H39 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="CaveBlocks" TileMode="Tile" Viewport="0,0,100,80" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF1E3540" Geometry="M0,0 H100 V80 H0 Z" />
                    <GeometryDrawing Brush="#FF28515B" Geometry="M4,5 H31 V30 H4 Z M64,5 H95 V25 H64 Z M38,43 H66 V74 H38 Z" />
                    <GeometryDrawing Brush="#FF183038" Geometry="M0,34 H100 V41 H0 Z M32,0 H39 V34 H32 Z M67,41 H73 V80 H67 Z" />
                    <GeometryDrawing Brush="#FF4A8C8E" Geometry="M11,10 H18 V17 H11 Z M76,12 H84 V20 H76 Z M47,52 H56 V61 H47 Z" />
                    <GeometryDrawing Brush="#FF8558A7" Geometry="M21,51 H27 V58 H21 Z M85,57 H92 V65 H85 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 所有图标均使用 8px 整数网格构成，避免曲线与抗锯齿风格。 -->
