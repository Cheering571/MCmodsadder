<Page x:Class="McModsAdder.Views.ProfileEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="编辑配置表">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Content="返回" Command="{Binding BackCommand}" Padding="10,4">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowLeft24" /></ui:Button.Icon>
            </ui:Button>
            <TextBlock Grid.Column="1" Text="{Binding Profile.Name}" Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center" Margin="14,0,14,0"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TextTertiary}">
                <Run Text="已添加 " /><Run Text="{Binding Entries.Count, Mode=OneWay}" /><Run Text=" 个 mod" />
            </TextBlock>
        </Grid>

        <!-- 搜索框 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox PlaceholderText="搜索 Modrinth 上的 mod，如：JEI、小地图、苹果皮…"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14" KeyDown="SearchTextBox_KeyDown">
                    <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
                </ui:TextBox>
                <Grid Grid.Column="1" Width="36" Height="36" Margin="10,0,0,0">
                    <ui:Button Command="{Binding SearchCommand}" ToolTip="搜索" Padding="0"
                               Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Search24" Width="30" Height="30" FontSize="30" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:ProgressRing IsIndeterminate="True" Width="30" Height="30"
                                     Foreground="{StaticResource AccentGreen}"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 搜索结果与已添加 Mod 对照区 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="搜索结果" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" Margin="4,0,4,10" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" SizeChanged="SearchResultsGrid_SizeChanged">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Height="60" CornerRadius="8" Margin="0,1" MouseLeftButtonUp="SearchResult_MouseLeftButtonUp" MouseMove="ModItem_MouseMove" MouseLeave="ModItem_MouseLeave" ToolTipOpening="ModItem_ToolTipOpening"
                                                ToolTipService.InitialShowDelay="120" ToolTipService.BetweenShowDelay="0">
                                            <Border.ToolTip>
                                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="RelativePoint" HorizontalOffset="16" VerticalOffset="16" Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False" IsHitTestVisible="False" MaxWidth="400">
                                                    <ToolTip.Template>
                                                        <ControlTemplate TargetType="{x:Type ToolTip}">
                                                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                        </ControlTemplate>
                                                    </ToolTip.Template>
                                                    <Border Background="#F52A303A" BorderBrush="#5546D369" BorderThickness="1" CornerRadius="12" Padding="14" Width="360">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Result.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Result.Author, StringFormat='作者：{0}'}" Margin="0,4,0,8" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                                                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                <TextBlock Text="{Binding Result.Summary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                                                            </ScrollViewer>
                                                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AccentGreen}">
                                                                <Run Text="下载量：" /><Run Text="{Binding Result.Downloads, Converter={StaticResource FriendlyNumber}}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#14FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="40" Height="40">
                                                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" Foreground="{StaticResource TextTertiary}" />
                                                    <Image Source="{Binding Icon}" Width="40" Height="40" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Result.Name}" VerticalAlignment="Center" Margin="12,0,8,0"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ui:Button Grid.Column="2" VerticalAlignment="Center" Content="{Binding IsAdded, Converter={StaticResource AddedToText}}"
                                                           IsEnabled="{Binding IsAdded, Converter={StaticResource InverseBool}}"
                                                           Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SearchHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource TextTertiary}"
                                       Visibility="{Binding SearchHint, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <ui:Button Content="上一页" Padding="10,3" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}" />
                            <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextTertiary}" />
                            <ui:Button Content="下一页" Padding="10,3" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="已添加的 Mod" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" Margin="4,0,4,10" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding EntryItems}" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Height="76" CornerRadius="8" Margin="0,1" MouseLeftButtonUp="SearchResult_MouseLeftButtonUp" MouseMove="ModItem_MouseMove" MouseLeave="ModItem_MouseLeave" ToolTipOpening="ModItem_ToolTipOpening"
                                            ToolTipService.InitialShowDelay="120" ToolTipService.BetweenShowDelay="0">
                                        <Border.ToolTip>
                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="RelativePoint" HorizontalOffset="16" VerticalOffset="16" Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False" IsHitTestVisible="False" MaxWidth="400">
                                                    <ToolTip.Template>
                                                        <ControlTemplate TargetType="{x:Type ToolTip}">
                                                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                        </ControlTemplate>
                                                    </ToolTip.Template>
                                                <Border Background="#F52A303A" BorderBrush="#5546D369" BorderThickness="1" CornerRadius="12" Padding="14" Width="360">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Entry.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Entry.Author, StringFormat='作者：{0}'}" Margin="0,4,0,8" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <TextBlock Text="{Binding Entry.Summary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                                                        </ScrollViewer>
                                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AccentGreen}">
                                                            <Run Text="下载量：" /><Run Text="{Binding Entry.Downloads, Converter={StaticResource FriendlyNumber}}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BadgeBg}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Background" Value="#263BA56A" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="40" Height="40" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" Foreground="{StaticResource TextTertiary}" />
                                                <Image Source="{Binding Icon}" Width="40" Height="40" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Entry.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Entry.Author, StringFormat='作者：{0}'}" FontSize="11" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Entry.Summary}" FontSize="11" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="下载 " /><Run Text="{Binding Entry.Downloads, Converter={StaticResource FriendlyNumber}, Mode=OneWay}" />
                                                </TextBlock>
                                                <ui:Button Grid.Row="1" Content="移除" Width="72" Padding="8,3" Margin="0,4,0,0"
                                                           Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding Entry}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
