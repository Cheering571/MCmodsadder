<Page x:Class="MCModPlus.Views.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      PreviewMouseDown="OnPagePreviewMouseDown"
      Title="配置表">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="配置表" Style="{StaticResource PageTitle}" />
            <TextBlock Text="搜索并添加mod到配置表"
                       Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
            <ui:Button Content="新建配置表" Command="{Binding CreateCommand}"
                       Style="{StaticResource GreenButton}" Margin="0,0,10,0">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="导入配置表" Command="{Binding ImportCommand}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowImport24" /></ui:Button.Icon>
            </ui:Button>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                       Foreground="{StaticResource TextTertiary}">
                <Run Text="共" /><Run Text="{Binding Profiles.Count, Mode=OneWay}" /><Run Text="个配置表" />
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DocumentTable24" FontSize="20"
                                                       Foreground="{StaticResource AccentGreen}" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextTertiary}">
                                            <Run Text="{Binding Entries.Count, Mode=OneWay}" /><Run Text=" 个 mod" />
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   Text="{Binding UpdatedAt, StringFormat='更新于 {0:yyyy-MM-dd HH:mm}'}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Content="编辑" Margin="0,0,8,0"
                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Edit24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="重命名" Margin="0,0,8,0"
                                                   Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Rename24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="导出" Margin="0,0,8,0"
                                                   Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Share24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button x:Name="DeleteButton" Tag="DeleteAction" Content="删除"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsDeletePending, Converter={StaticResource InverseBoolToVisibility}}">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button x:Name="DeleteConfirmButton" Tag="DeleteAction" Content="确认" Appearance="Danger" Foreground="White"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsDeletePending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinHeight="300"
                        Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="DocumentTable24" FontSize="56" Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center" />
                <TextBlock Text="还没有配置表" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,16,0,6" />
                <TextBlock Text="新建一个配置表，把你常玩的 mod 都加进去，以后换整合包一键补齐"
                           FontSize="13" Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding MessageText}" FontSize="12" Margin="0,8,0,0"
                   Foreground="{StaticResource TextTertiary}" />
    </Grid>
</Page>
