<Page x:Class="MCModPlus.Views.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="游戏实例"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="游戏实例" Style="{StaticResource PageTitle}" />
            <TextBlock Text="自动识别已存在的游戏文件夹，支持手动添加"
                       Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <WrapPanel VerticalAlignment="Center">
                <ui:Button Content="自动扫描" Command="{Binding RescanCommand}" Margin="0,0,10,8">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="手动添加" Command="{Binding BrowseCommand}" Style="{StaticResource GreenButton}" Margin="0,0,10,8">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                </ui:Button>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="6,0,16,8"
                           Foreground="{StaticResource TextTertiary}" FontSize="12" />
            </WrapPanel>
            <WrapPanel>
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="筛选" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                                   FontWeight="SemiBold" Margin="0,0,10,0" />
                        <ui:TextBox Width="160" Height="34" PlaceholderText="搜索实例名称或路径"
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <ComboBox Width="120" Height="34" ItemsSource="{Binding LoaderOptions}"
                                  SelectedItem="{Binding SelectedLoader}" Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Width="130" Height="34" ItemsSource="{Binding GameVersionOptions}"
                                  SelectedItem="{Binding SelectedGameVersion}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="排序" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                                   FontWeight="SemiBold" Margin="0,0,10,0" />
                        <ComboBox Width="120" Height="34" ItemsSource="{Binding SortModes}"
                                  SelectedItem="{Binding SortMode}" />
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Left" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="原版" IsChecked="{Binding ShowVanilla, Mode=TwoWay}"
                                  MinWidth="0" Padding="0" HorizontalContentAlignment="Left"
                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding VanillaInstanceCount, StringFormat='{}{0}个'}"
                                   FontSize="11" Foreground="{StaticResource TextTertiary}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding InstancesView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=ActualWidth}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Stretch" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="0,0,0,1" CornerRadius="10" Padding="4,10" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource AccentGreenDeep}" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource GroupHeaderText}}" Foreground="White"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="  实例" Foreground="{StaticResource TextTertiary}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                            <TextBlock Text="  （" Foreground="{StaticResource TextTertiary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ItemCount}" Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text=" 个）" Foreground="{StaticResource TextTertiary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Width="300" Height="142" Margin="0,0,16,16"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="删除实例"
                                                  Command="{Binding PlacementTarget.Tag.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" MaxHeight="38" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Badge}" Background="#332F78D0">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{StaticResource InfoBrush}"
                                                       Text="{Binding GameVersion, FallbackValue='?', TargetNullValue='?'}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                Background="{Binding Loader, Converter={StaticResource LoaderToBackgroundBrush}}">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{Binding Loader, Converter={StaticResource LoaderToBrush}}"
                                                       Text="{Binding Loader, Converter={StaticResource InstanceLoaderToText}}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding DirectoryPath}" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" MaxHeight="40" ToolTip="{Binding DirectoryPath}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasInstances, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="Cube24" FontSize="56" Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center" />
                <TextBlock Text="尚未发现游戏实例" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,16,0,6" />
                <TextBlock Text="点击上方「选择整合包目录」，选择 .minecraft、versions 或实例目录"
                           FontSize="13" Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
