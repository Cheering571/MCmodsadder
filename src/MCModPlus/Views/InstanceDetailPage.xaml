<Page x:Class="MCModPlus.Views.InstanceDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="实例详情">
    <DockPanel Margin="32,24">

        <!-- 底部操作栏 -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,12"
                Visibility="{Binding HasCompared, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondary}">
                        <Run Text="已装 " /><Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                        <Run Text=" · 缺失 " /><Run Text="{Binding MissingCount, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                        <Run Text=" · 无可用版本 " /><Run Text="{Binding UnavailableCount, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="强制加入不匹配的本地 Mod" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" />
                    <CheckBox IsChecked="{Binding ForceLocalMods, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTip="忽略本地 Mod 的 MC 版本和加载器匹配检查" Margin="0,0,12,0" />
                    <ui:Button Style="{StaticResource GreenButton}"
                               Content="一键补装缺失 mod" Command="{Binding StartInstallCommand}"
                               IsEnabled="{Binding CanInstall}" FontSize="14" Padding="18,8">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 顶部页面操作 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <ui:Button HorizontalAlignment="Left" Content="返回" Command="{Binding BackCommand}" Padding="10,4">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowLeft24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button HorizontalAlignment="Right" Content="重新识别 mod" Command="{Binding RefreshModsCommand}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- 顶部实例信息横幅 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource InfoBrush}"
                                   Text="{Binding Instance.GameVersion, FallbackValue='?', TargetNullValue='?'}" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                            Background="{Binding Instance.Loader, Converter={StaticResource LoaderToBackgroundBrush}}">
                        <TextBlock Style="{StaticResource BadgeText}"
                                   Foreground="{Binding Instance.Loader, Converter={StaticResource LoaderToBrush}}"
                                   Text="{Binding Instance.Loader, Converter={StaticResource LoaderToText}}" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource TextSecondary}">
                            <Run Text="已装 mod " /><Run Text="{Binding InstalledMods.Count, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Instance.DirectoryPath}" FontSize="11" Margin="0,10,0,0"
                           Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
        </Border>

        <!-- 主体：头部固定，仅列表滚动 -->
        <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 配置表选择 -->
            <Border Style="{StaticResource Card}" Padding="18,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="配置表" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Width="260" ItemsSource="{Binding Profiles}"
                                  DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" />
                        <ui:Button Content="管理配置表" Command="{Binding GoProfilesCommand}" Margin="10,0,0,0">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentTable24" /></ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            <!-- 对比列表与过程状态 -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36">
                                            <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22"
                                                           Foreground="{StaticResource TextTertiary}" />
                                            <Image Source="{Binding Icon}" Width="36" Height="36" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Entry.Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding Entry.Summary}" FontSize="12" MaxWidth="520"
                                                       Foreground="{StaticResource TextTertiary}"
                                                       HorizontalAlignment="Left"
                                                       TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0"
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                   Text="{Binding VersionText}" />
                                        <Border Grid.Column="3" Style="{StaticResource Badge}" HorizontalAlignment="Center">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{Binding Status, Converter={StaticResource CompStatusToBrush}}"
                                                       Text="{Binding Status, Converter={StaticResource CompStatusToText}}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Panel.ZIndex="10" Style="{StaticResource Card}" Padding="0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                        <TextBlock Text="{Binding BusyText}" Margin="0,14,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 已安装 mod 状态与详情入口 -->
            <ui:Button Grid.Row="2" Margin="0,10,0,0" Padding="14,10"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                       Click="InstalledModsButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True"
                                         Foreground="{StaticResource AccentGreen}"
                                         Visibility="{Binding HasRecognizedMods, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:SymbolIcon Symbol="Document24" FontSize="21"
                                       Foreground="{StaticResource AccentGreen}"
                                       Visibility="{Binding HasRecognizedMods, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding InstalledModsHeader}" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="18"
                                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                </Grid>
            </ui:Button>
        </Grid>

    </DockPanel>
</Page>
