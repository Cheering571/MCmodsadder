<Page x:Class="MCModPlus.Views.ProfileEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="编辑配置表">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Content="返回" Command="{Binding BackCommand}" Padding="10,4">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowLeft24" /></ui:Button.Icon>
            </ui:Button>
            <TextBlock Grid.Column="1" Text="{Binding Profile.Name}" Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center" Margin="14,0,14,0"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TextTertiary}">
                <Run Text="已添加 " /><Run Text="{Binding Entries.Count, Mode=OneWay}" /><Run Text=" 个 mod" />
            </TextBlock>
        </Grid>

        <!-- 搜索与本地 Mod 库功能区 -->
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{Binding SearchPlaceholder}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" KeyDown="SearchTextBox_KeyDown">
                        <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
                    </ui:TextBox>
                    <Grid Grid.Column="1" Width="36" Height="36" Margin="10,0,8,0">
                        <ui:Button Command="{Binding SearchCommand}" ToolTip="搜索" Padding="0"
                                   Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Search24" Width="30" Height="30" FontSize="30" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:ProgressRing IsIndeterminate="True" Width="30" Height="30"
                                         Foreground="{StaticResource AccentGreen}"
                                         Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <ComboBox Grid.Column="2" Width="78" MinWidth="78" MaxWidth="78" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ItemsSource="{Binding SearchSourceOptions}"
                              SelectedItem="{Binding SelectedSearchSource}" ToolTip="选择搜索来源">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Globe24" Width="16" Height="16" Foreground="{StaticResource AccentGreen}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconText}" Value="CurseForge">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Viewbox.Style>
                                            <Style TargetType="Viewbox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconText}" Value="CurseForge"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Viewbox.Style>
                                        <Path Fill="#F16436" Data="M18.326,9.2145 S23.2261,8.4418 24,6.1882 H16.4934 V4.4 H0 L2.0318,6.7576 V9.173 S7.1587,8.906 9.1418,10.4102 C11.856,12.9262 6.0988,16.3272 6.0988,16.3272 L5.0995,19.6 C6.646,18.1274 9.5938,16.2225 14.9978,16.3143 C12.9418,16.9643 10.8737,17.9793 9.2639,19.6 H20.1887 L19.1599,16.3274 S11.2419,11.6587 18.326,9.2145 Z" />
                                    </Viewbox>
                                    <TextBlock Text="|" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}"
                                               Visibility="{Binding HasSecondaryIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center"
                                             Visibility="{Binding HasSecondaryIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Path Fill="#F16436" Data="M18.326,9.2145 S23.2261,8.4418 24,6.1882 H16.4934 V4.4 H0 L2.0318,6.7576 V9.173 S7.1587,8.906 9.1418,10.4102 C11.856,12.9262 6.0988,16.3272 6.0988,16.3272 L5.0995,19.6 C6.646,18.1274 9.5938,16.2225 14.9978,16.3143 C12.9418,16.9643 10.8737,17.9793 9.2639,19.6 H20.1887 L19.1599,16.3274 S11.2419,11.6587 18.326,9.2145 Z" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid Width="78">
                                    <ToggleButton x:Name="ToggleButton" Width="78" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Globe24" Width="16" Height="16" Foreground="{StaticResource AccentGreen}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.IconText, RelativeSource={RelativeSource TemplatedParent}}" Value="CurseForge">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <Viewbox Width="16" Height="16">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.IconText, RelativeSource={RelativeSource TemplatedParent}}" Value="CurseForge"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Viewbox.Style>
                                                    <Path Fill="#F16436" Data="M18.326,9.2145 S23.2261,8.4418 24,6.1882 H16.4934 V4.4 H0 L2.0318,6.7576 V9.173 S7.1587,8.906 9.1418,10.4102 C11.856,12.9262 6.0988,16.3272 6.0988,16.3272 L5.0995,19.6 C6.646,18.1274 9.5938,16.2225 14.9978,16.3143 C12.9418,16.9643 10.8737,17.9793 9.2639,19.6 H20.1887 L19.1599,16.3274 S11.2419,11.6587 18.326,9.2145 Z" />
                                                </Viewbox>
                                                <Viewbox Width="16" Height="16" Margin="3,0,0,0"
                                                         Visibility="{Binding SelectedItem.HasSecondaryIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Fill="#F16436" Data="M18.326,9.2145 S23.2261,8.4418 24,6.1882 H16.4934 V4.4 H0 L2.0318,6.7576 V9.173 S7.1587,8.906 9.1418,10.4102 C11.856,12.9262 6.0988,16.3272 6.0988,16.3272 L5.0995,19.6 C6.646,18.1274 9.5938,16.2225 14.9978,16.3143 C12.9418,16.9643 10.8737,17.9793 9.2639,19.6 H20.1887 L19.1599,16.3274 S11.2419,11.6587 18.326,9.2145 Z" />
                                                </Viewbox>
                                            </StackPanel>
                                            <Path Grid.Column="1" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{StaticResource TextSecondary}"
                                                  Data="M 0 0 L 8 0 L 4 5 Z" />
                                        </Grid>
                                    </ToggleButton>
                                    <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                        <Border Width="220" Margin="0,4,0,0" Padding="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
                                            <ScrollViewer CanContentScroll="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <ui:Button Content="打开本地 Mod 库" Height="36" HorizontalAlignment="Stretch"
                           Click="OpenLocalModLibrary_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Library24" /></ui:Button.Icon>
                </ui:Button>
            </Border>
        </Grid>

        <!-- 搜索结果与已添加 Mod 对照区 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="搜索结果" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" Margin="4,0,4,10" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" SizeChanged="SearchResultsGrid_SizeChanged">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Height="60" CornerRadius="8" Margin="0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#14FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="40" Height="40">
                                                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" Foreground="{StaticResource TextTertiary}" />
                                                    <Image Source="{Binding Icon}" Width="40" Height="40" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                                    <TextBlock Text="{Binding Result.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Result.Source}" FontSize="11" Foreground="{StaticResource TextTertiary}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" VerticalAlignment="Center" Content="{Binding IsAdded, Converter={StaticResource AddedToText}}"
                                                           IsEnabled="{Binding IsAdded, Converter={StaticResource InverseBool}}"
                                                           Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SearchHint}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource TextTertiary}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16,0"
                                       Visibility="{Binding SearchHint, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <ui:Button Content="上一页" Padding="10,3" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}" />
                            <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextTertiary}" />
                            <ui:Button Content="下一页" Padding="10,3" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="已添加的 Mod" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" Margin="4,0,4,10" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding EntryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Height="52" CornerRadius="8" Margin="0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BadgeBg}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Background" Value="#263BA56A" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="20" Foreground="{StaticResource TextTertiary}" />
                                                <Image Source="{Binding Icon}" Width="32" Height="32" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Entry.Name}" VerticalAlignment="Center" Margin="12,0,10,0"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ui:Button Grid.Column="2" Content="移除" Width="72" Padding="8,3" VerticalAlignment="Center"
                                                       Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding Entry}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
