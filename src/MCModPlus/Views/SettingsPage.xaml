<Page x:Class="MCModPlus.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:MCModPlus.Views"
      Title="设置"
      PreviewMouseDown="OnPagePreviewMouseDown">
    <ScrollViewer Margin="32,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="640">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="所有设置自动保存" Style="{StaticResource PageSubtitle}" Margin="0,4,0,18" />

            <!-- API 源 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Modrinth API 源" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="国内网络访问官方源不稳定时，切换到 MCIM 镜像"
                               FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,10" />
                    <ComboBox Width="280" HorizontalAlignment="Left"
                              SelectedIndex="{Binding UseMirror, Converter={StaticResource BoolToIndex}}">
                        <ComboBoxItem Content="Modrinth 官方（api.modrinth.com）" />
                        <ComboBoxItem Content="MCIM 国内镜像（mod.mcimirror.top）" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- CurseForge API -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CurseForge API" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="输入 API Key；留空时使用默认 Key。点击修改后编辑，点击确认保存。"
                               FontSize="12" Foreground="{StaticResource TextTertiary}"
                               Margin="0,4,0,10" TextWrapping="Wrap" />
                    <ui:TextBox Width="Auto" MinHeight="32" Tag="CurseForgeApiInput"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="{Binding CurseForgeApiPlaceholder}"
                                Text="{Binding CurseForgeApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsCurseForgeApiEditing}" />
                    <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Left">
                        <ui:Button Width="72" Height="32" Margin="0,0,8,0"
                                   Tag="CurseForgeApiEditAction" Content="修改"
                                   Command="{Binding ToggleCurseForgeApiEditCommand}"
                                   Visibility="{Binding IsCurseForgeApiEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button Width="72" Height="32" Margin="0,0,8,0"
                                   Tag="CurseForgeApiEditAction" Content="确认"
                                   Command="{Binding ToggleCurseForgeApiEditCommand}"
                                   Visibility="{Binding IsCurseForgeApiEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button">
                                    <Setter Property="Background" Value="{StaticResource AccentGreen}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ui:Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentGreenDark}" />
                                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentGreenDark}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentGreenDeep}" />
                                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentGreenDeep}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Width="72" Height="32" Margin="0,0,8,0"
                                   Tag="CurseForgeApiClearAction" Content="清除"
                                   Command="{Binding ClearCurseForgeApiCommand}"
                                   Visibility="{Binding IsCurseForgeApiClearPending, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button Width="72" Height="32"
                                   Tag="CurseForgeApiClearAction" Content="确认"
                                   Appearance="Danger" Foreground="White"
                                   Command="{Binding ClearCurseForgeApiCommand}"
                                   Visibility="{Binding IsCurseForgeApiClearPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 依赖 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <ui:ToggleSwitch IsChecked="{Binding AutoInstallDependencies}">自动安装必需依赖</ui:ToggleSwitch>
                    <TextBlock Text="补装 mod 时自动下载其必需的前置 mod（推荐开启）"
                               FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 并发 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}">
                        <Run Text="下载并发数：" /><Run Text="{Binding DownloadConcurrency, StringFormat='{}{0:0}', Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="1" Maximum="16" Value="{Binding DownloadConcurrency}"
                            Margin="0,10,0,0" TickFrequency="1" IsSnapToTickEnabled="True" />
                </StackPanel>
            </Border>

            <!-- 备份 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <ui:ToggleSwitch IsChecked="{Binding BackupEnabled}">写入前备份旧文件</ui:ToggleSwitch>
                    <TextBlock Text="被替换的旧 mod 文件会移入 mods/备份目录"
                               FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="关于" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text=" · " FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VersionText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <ui:Button Width="34" Height="34" Margin="16,0,0,0"
                                   Padding="0" HorizontalAlignment="Left" ToolTip="访问 GitHub 项目"
                                   Click="OpenGitHub_Click">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource TextPrimary}"
                                  Data="M12,.5A12,12,0,0,0,8.21,23.89c.6,.11,.82,-.26,.82,-.58V21.27c-3.34,.73,-4.04,-1.61,-4.04,-1.61c-.55,-1.39,-1.34,-1.76,-1.34,-1.76c-1.09,-.75,.08,-.74,.08,-.74c1.2,.09,1.83,1.23,1.83,1.23c1.07,1.83,2.8,1.3,3.48,.99c.11,-.77,.42,-1.3,.76,-1.6c-2.67,-.3,-5.47,-1.34,-5.47,-5.94c0,-1.31,.47,-2.38,1.23,-3.22c-.12,-.3,-.53,-1.52,.12,-3.18c0,0,1,-.32,3.3,1.23a11.5,11.5,0,0,1,6,0c2.29,-1.55,3.29,-1.23,3.29,-1.23c.65,1.66,.24,2.88,.12,3.18c.77,.84,1.23,1.91,1.23,3.22c0,4.61,-2.8,5.63,-5.48,5.93c.43,.37,.81,1.1,.81,2.22v3.29c0,.32,.22,.69,.83,.57A12,12,0,0,0,12,.5Z" />
                        </ui:Button>
                    </StackPanel>
                    <TextBlock FontSize="11" Margin="0,8,0,0" Foreground="{StaticResource TextTertiary}"
                               TextTrimming="CharacterEllipsis" Text="{Binding DataDirText, StringFormat=数据目录：{0}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
