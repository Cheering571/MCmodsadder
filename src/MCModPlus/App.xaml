<Application x:Class="MCModPlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:MCModPlus.Converters"
             xmlns:helpers="clr-namespace:MCModPlus.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollViewer">
                <Setter Property="helpers:ScrollHelper.AutoHideScrollBars" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Width="8"
                                           Margin="4,0,0,0"
                                           Orientation="Vertical"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                    <ScrollBar.Template>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="Transparent" BorderBrush="Transparent" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb MinHeight="24" Background="#805D6673">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="Transparent" BorderBrush="Transparent" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </ControlTemplate>
                                    </ScrollBar.Template>
                                </ScrollBar>
                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Height="8"
                                           Margin="0,4,0,0"
                                           Orientation="Horizontal"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Value="{TemplateBinding HorizontalOffset}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 品牌色与功能色 -->
            <SolidColorBrush x:Key="AccentGreen" Color="#46D369" />
            <SolidColorBrush x:Key="AccentGreenDark" Color="#3BA55D" />
            <SolidColorBrush x:Key="AccentGreenDeep" Color="#2E8B57" />
            <SolidColorBrush x:Key="CardBg" Color="#E61F232B" />
            <SolidColorBrush x:Key="CardBgHover" Color="#FF262B35" />
            <SolidColorBrush x:Key="CardBorder" Color="#FF2E333D" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#C7CBD1" />
            <SolidColorBrush x:Key="TextTertiary" Color="#8A9099" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#46D369" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0B232" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E81123" />
            <SolidColorBrush x:Key="InfoBrush" Color="#3B9CDF" />
            <SolidColorBrush x:Key="BadgeBg" Color="#FF262B35" />

            <!-- 转换器 -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
            <converters:LoaderToBrushConverter x:Key="LoaderToBrush" />
            <converters:LoaderToBackgroundBrushConverter x:Key="LoaderToBackgroundBrush" />
            <converters:LoaderToTextConverter x:Key="LoaderToText" />
            <converters:InstanceLoaderToTextConverter x:Key="InstanceLoaderToText" />
            <converters:GroupHeaderTextConverter x:Key="GroupHeaderText" />
            <converters:ComparisonStatusToBrushConverter x:Key="CompStatusToBrush" />
            <converters:ComparisonStatusToTextConverter x:Key="CompStatusToText" />
            <converters:InstallStateToBrushConverter x:Key="InstallStateToBrush" />
            <converters:BoolToIndexConverter x:Key="BoolToIndex" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:AddedToTextConverter x:Key="AddedToText" />

            <!-- 卡片 -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- 标题 -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            </Style>

            <!-- 徽章 -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Background" Value="{StaticResource BadgeBg}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="BadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 卡片按钮（实例卡片等可点击卡片） -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreenDark}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 主操作绿色按钮（Primary 外观，强调色已在启动时设为品牌绿） -->
            <Style x:Key="GreenButton" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="Appearance" Value="Primary" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
